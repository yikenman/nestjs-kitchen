{
  "$schema": "./node_modules/syncpack/schema.json",
  "sortPackages": true,
  "sortFirst": [
    "name",
    "private",
    "description",
    "version",
    "homepage",
    "repository",
    "author",
    "license",
    "exports",
    "main",
    "module",
    "types",
    "files",
    "scripts"
  ],
  "semverGroups": [
    {
      "range": "^",
      "dependencies": [
        "!$LOCAL"
      ],
      "dependencyTypes": [
        "dev",
        "peer",
        "prod"
      ]
    }
  ],
  "versionGroups": [
    {
      "label": "Use workspace protocol when developing local packages",
      "dependencies": [
        "$LOCAL"
      ],
      "dependencyTypes": [
        "dev",
        "peer",
        "prod"
      ],
      "pinVersion": "workspace:*"
    },
    {
      "label": "Ignore conflict deps",
      "packages": [
        "@nestjs-kitchen/authz",
        "@nestjs-kitchen/cache-manager"
      ],
      "dependencies": [
        "@nestjs/platform-express"
      ],
      "isIgnored": true
    }
  ]
}
